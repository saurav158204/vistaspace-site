# Normalise line endings: LF in the repo, native in the working copy.
* text=auto eol=lf

# Binary assets — never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.pdf binary

# Keep lockfile diffs out of review noise
package-lock.json -diff linguist-generated
